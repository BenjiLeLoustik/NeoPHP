{
    "name": "bboezio/neophp",
    "description": "NeoPHP - PHP8 Framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Benjamin Boezio"
        }
    ],
    "require": {
        "php": ">=8.5",
        "twig/twig": "^3.0",
        "psr/container": "^2.0",
        "matthiasmullie/minify": "^1.3",
        "ext-pdo": "*",
        "ext-zip": "*",
        "ext-libxml": "*",
        "ext-dom": "*",
        "wikimedia/less.php": "^5.4",
        "twig/intl-extra": "^3.23",
        "ext-ftp": "*",
        "ext-iconv": "*",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "phpmailer/phpmailer": "^7.1",
        "ext-fileinfo": "*",
        "predis/predis": "3.5.1",
        "test/app": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "13.2.4",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Neo\\": "neo/",
            "Neo\\Src\\": "src/"
        },
        "exclude-from-classmap": [
            "/src/*/Database/Migrations/",
            "/src/*/Storage/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "src/Test",
            "options": {
                "symlink": false
            }
        }
    ]
}
