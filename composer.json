{
    "name": "neophp-dev/neophp",
    "description": "Modern PHP 8.5 MVC framework with ORM, Twig templating, routing and CLI tools.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Benjamin Boezio",
            "homepage": "https://github.com/BenjiLeLoustik"
        }
    ],
    "homepage": "https://github.com/NeoPHP-Dev/NeoPHP",
    "support": {
        "issues": "https://github.com/NeoPHP-Dev/NeoPHP/issues"
    },
    "keywords": [
        "neophp",
        "php",
        "framework",
        "mvc",
        "orm",
        "twig",
        "php8",
        "web",
        "router",
        "cli",
        "database"
    ],
    "require": {
        "php": ">=8.5",
        "twig/twig": "^3.0",
        "psr/container": "^2.0",
        "matthiasmullie/minify": "^1.3",
        "ext-pdo": "*",
        "ext-zip": "*",
        "ext-libxml": "*",
        "ext-dom": "*",
        "wikimedia/less.php": "^5.4",
        "twig/intl-extra": "^3.23",
        "ext-ftp": "*",
        "ext-iconv": "*",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "phpmailer/phpmailer": "^7.1",
        "ext-fileinfo": "*",
        "predis/predis": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Neo\\": "neo/",
            "Neo\\Src\\": "src/"
        },
        "exclude-from-classmap": [
            "/src/*/Database/Migrations/",
            "/src/*/Storage/"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": []
}
